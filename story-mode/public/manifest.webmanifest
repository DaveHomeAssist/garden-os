    { "src": "icons/android-chrome-192.png", "type": "image/png", "sizes": "192x192", "purpose": "any" },
    { "src": "icons/android-chrome-512.png", "type": "image/png", "sizes": "512x512", "purpose": "any" },
    { "src": "icons/apple-touch-icon.png", "type": "image/png", "sizes": "180x180" }
  ],
  "shortcuts": [
